{
  "name": "fr.openent~flashquizz-connector",
  "config": {
    "main" : "fr.openent.flashquizz.FlashquizzConnector",
    "port" : 8047,
    "csrf-token": {{ csrfToken | default('true') }},
    "app-name" : "Flashquizz-connector",
    "app-address" : "/flashquizz-connector",
    "app-icon" : "flashquizz-large",
    "app-type" : "SYSTEM",
    "host": "https://{{ host }}",
    "ssl" : true,
    "auto-redeploy": false,
    "userbook-host": "https://{{ host }}",
    "integration-mode": "{{ integration_mode|default('HTTP') }}",
    "app-registry.port" : 8012,
    "mode" : "prod",
    "entcore.port" : 8009,
    "eb-address": "{{ flashquizzConnectorEbAdress | default('fr.openent.ssoflashquizz') }}",
    "path-prefix": "flashquizz-connector"
  }
}
